# Copy this file to .env and fill in your own key. .env is gitignored.
ELECTRICITY_MAPS_API_KEY=your_key_here
ELECTRICITY_MAPS_BASE_URL=https://api.electricitymaps.com/v4
DEFAULT_ZONE=US-NE-ISNE

#Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The Twilio number texts come from (E.164, e.g. +16175550123), or a Messaging Service SID instead.
TWILIO_FROM_NUMBER=your_twilio_phone_number
# TWILIO_MESSAGING_SERVICE_SID=
